[Unit]
Description=bare-server static site server
After=network-online.target
Wants=network-online.target

# Every startup error is fatal (bad config, unreadable cert, bind failure), and
# the default budget of 5 starts in a 10s window trips almost immediately at
# RestartSec=5 — a transient fault (root not mounted yet, listen IP not assigned)
# would leave the unit permanently failed. StartLimitIntervalSec is the *window*
# systemd counts starts over, not a retry duration: to actually keep retrying for
# ~5 minutes the burst must span it. At RestartSec=5 a start happens every ~5s, so
# 60 starts fill a 300s window — i.e. it retries for ~5 minutes before giving up.
StartLimitIntervalSec=300
StartLimitBurst=60

[Service]
Type=simple
User=bare-server
Group=bare-server
ExecStart=/usr/local/bin/bare-server /etc/bare-server/server.conf
Restart=always
RestartSec=5

# The concurrency caps in main.rs (MAX_CONNS 1024 + MAX_CONNS_HTTP 256) allow
# ~1280 sockets held for up to CONN_MAX_SECS, above systemd's 1024 default soft
# limit — accept() would fail with EMFILE before the anti-DoS cap ever engaged.
# Headroom here covers the listeners plus the fds the reload path opens.
LimitNOFILE=16384

# Bind 80/443 as a non-root user via an ambient capability (no sysctl hacks).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: the server only reads files and opens TCP sockets.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallFilter=@system-service
# Without this the syscall allowlist is installed per-ABI only: an attacker with
# code execution could reissue a blocked call through a secondary ABI (x32, or
# i386's int 0x80) on x86-64. Confining to the native ABI closes that bypass.
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
